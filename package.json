{
  "name": "@deepwhale-cn/dsh-secret-scan",
  "version": "0.2.0",
  "description": "密钥与敏感信息扫描：提交前、发布前把代码里的 API Key、令牌、私钥、凭据文件、内部域名找出来 —— 输出默认打码，可作为 pre-commit / CI 卡口。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill",
    "secret-scan",
    "credential",
    "security",
    "pre-commit",
    "leak",
    "api-key",
    "token",
    "private-key",
    "devsecops",
    "chinese"
  ],
  "files": [
    "lib",
    "bin",
    "rules",
    "skill",
    "cordis.patch.yml",
    "tests/fixtures",
    "README.md",
    "LICENSE"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-secret-scan.git"
  },
  "homepage": "https://www.deepwhale.org.cn/guard.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-secret-scan/issues"
  },
  "dependencies": {
    "@deepwhale-cn/dsh-guard-core": "^0.5.1"
  },
  "bin": {
    "dsh-secret-scan": "bin/cli.mjs"
  }
}